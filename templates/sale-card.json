{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    { "type": "TextBlock", "text": "🎫 {{title}}", "weight": "Bolder", "size": "Large", "wrap": true },
    { "type": "TextBlock", "text": "{{artist}}｜{{venue}}", "wrap": true },
    {
      "type": "FactSet",
      "facts": [
        { "title": "開賣時間", "value": "{{sale_at}}" },
        { "title": "售票平台", "value": "{{platform}}" }
      ]
    },
    { "type": "TextBlock", "text": "先設好鬧鐘、登入售票帳號。", "isSubtle": true, "wrap": true }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "🎫 前往購票", "url": "{{url}}" }
  ]
}
