{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    { "type": "TextBlock", "text": "🎤 明天 {{artist}} 演出", "weight": "Bolder", "size": "Large", "wrap": true },
    {
      "type": "FactSet",
      "facts": [
        { "title": "演出日期", "value": "{{show_date}}" },
        { "title": "場地", "value": "{{venue}}" }
      ]
    },
    { "type": "TextBlock", "text": "記得帶票和證件。", "isSubtle": true, "wrap": true }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "🎫 售票頁", "url": "{{url}}" }
  ]
}
